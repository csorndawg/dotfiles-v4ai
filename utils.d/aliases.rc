# runtime config file with shell-agnostic aliases 

alias gs="git status"
alias gm="git merge"
alias glg="git log"
alias gcm="git commit"
alias gbl="git branch -la"
# sorted with the most recent commits first
alias gbs="git branch -la --sort=-committerdate"
# sorted with the oldest commits first
alias gbS="git branch -la --sort=-committerdate"
alias gcb="git checkout -b"
alias gcmn="git checkout main"
alias gpl="git pull"
alias python="python3"
alias egv="egrep -v"
alias la="ls -la"
alias ll="ls -l"
alias ce="cheat -e"
alias cl="cheat -l"
alias XARGS="$(which xargs)"
alias xargs="xargs -I \"{}\""
alias fdcw="fd --changed-within"
alias fdcb="fd --changed-before"

