# runtime config file with shell-agnostic functions

function mcd() {
    local dirPath="$1"
    if [[ -z "$1" ]]; then
	    echo "Error - required path argument was not provided"
	    return 1
    else
	    mkdir -p "$dirPath"
	    cd "$dirPath"

	    echo "Created dirpath: $dirPath"
	    echo ""
    fi
}


#
# passes list of available venvs to FZF and activates selected venv
function __setVenv() {
  
  local persist_venvs="$HOME/.config/venvs"
  local activate_rgx='bin.activate$'

  if [[ $# -eq 0 ]]; then
    echo "No argument provided. Using persistent bucket"

    # store selected path so we can enable (run it)
    activatePath="$( fd -a -t f --regex "acti" . "$persist_venvs" | \
      egrep "$activate_rgx" | \
      fzf  --highlight-line     \
        --wrap        \
        --height 40% \
        --prompt="venvs>  " \
        --ghost="nothing to pick from" \
        --exit-0  \
        --select-1)"
  else
    echo "Argument provided. Using current filetree bucket"
    echo -n "\nDebugging Cmd:\t \"fd -a -t f --regex \"acti\" . \"$(pwd -P)\""

    activatePath="$( fd -a -t f -HI --regex "acti" . "$(pwd -P)" | \
      egrep "$activate_rgx" | \
      fzf  --highlight-line     \
        --wrap        \
        --height 40% \
        --prompt="venvs>  " \
        --ghost="nothing to pick from" \
        --exit-0  \
        --select-1)"
 fi

 # activate selected venv
 . $activatePath
 echo "Activated:  $(echo $activatePath | awk -F '/' '{print $(NF-2)}')"
}




#
# Remote machine OSC 52 clipboard workaround
if ! hostname | grep -q "zac.hp"; then
  echo "Remote machine"
  clip() {
      printf "\033]52;c;$(base64 -w0)\a"
  }
else
  echo "Local machine"
fi

# git rebase helper
# Interactive rebase helper

function grbi() {
  # verify the input is a positive int
  if [[ -n "$1" && "$1" =~ ^[0-9]+$ ]]; then
    echo "Starting interactive rebase for the last $1 commits..."
    git rebase -i "HEAD~$1"
  else
    echo "Error: Please provide a valid number of commits."
    echo "Usage: grb 3"
  fi
}

# resolves missing path components automatically for given path 
# kind of like "mcd()" but for nvim paths
function nvp() { 

  # when no input paths given, run NVIM with no args
  if [ -z "$1" ]; then
    nvim
    return 0
  fi

  # collect/parse path arguments
  local paths=("$@")
  local dirs_to_create=()

  for path in "${paths[@]}"; do
    local parent_dir="$(dirname "$path")"
    if [ ! -d "$parent_dir" ]; then
      dirs_to_create+=("$parent_dir")
    fi
  done

  if [ ${#dirs_to_create[@]} -gt 0 ]; then
    mkdir -pv "${dirs_to_create[@]}"
  fi

  #echo -e "Debug:\tnvim $(printf '"%s" ' "${paths[@]}")"
  nvim "${paths[@]}"
}



