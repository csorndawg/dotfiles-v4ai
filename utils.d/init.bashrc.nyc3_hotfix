###############################################################
# Archiving current bashrc configuration code as first step 
# to migrate code to "init.bashrc" in dotfiles that be symlinked 
# to "bashrc" 
###############################################################

# aliases
alias gs="git status"
alias gd="git diff"
alias gcm="git commit"
alias gcmn="git checkout main"
alias jc="jupyter console"
alias jl="jupyter lab"
alias v="vim"
alias python="python3"
alias py="python"
alias XARGS="$(which xargs)"
alias xargs='xargs -I "{}"'
alias nv="nvim"
alias lla="ls -al"
alias LS="$(which ls)"
alias ls="ls -l"
alias la="ls -a"
alias eg="egrep"
alias egv="egrep -v"
alias egc="egrep -c"
alias egi="egrep -i"
alias NV="nvim"
alias ZI="zi"
alias ce="cheat -e"
alias cl="cheat -l | egrep -i"


## common dirs
#export BASHRC="$HOME/.bashrc"
#export GIT_HOME="$HOME/git"
#export ZDAT_HOME="/zdat"
#export SRV_HOME="/srv/local"
#export OPT_HOME="/opt/local"
#export XDG_CONFIG_HOME="$HOME/.config"
#export XDG_BIN_HOME="$HOME/.local/bin"
#export XDG_LOCAL_HOME="$HOME/.local"
#export XDG_LIB_HOME="$HOME/.local/lib"

# add to PATH
export PATH="$PATH:$HOME/.local/bin"

# ssh key cred caching
eval "$(ssh-agent -s)" 1>/dev/null
sshCachePassRunner="$HOME/.ssh/sshCachePass.sh"
source "$sshCachePassRunner" 1> /dev/null

# rust setup
export PATH="$PATH:$HOME/.cargo/bin"
. "$HOME/.cargo/env"

# zoxide
eval "$(zoxide init bash)"
#eval "$(zoxide init zsh)"

# fdfind symlink to binary
if [ ! -e ~/.local/bin/fd ]; then
	ln -s "$(command -v fdfind)" "$HOME/.local/bin/fd"
fi

# golang setup
export GOPATH="/usr/lib/go"
export GOBIN="$GOPATH/bin"
export PATH="$PATH:$GOBIN"

# venvs
export VENVS_HOME="$HOME/.config/venvs"
alias vv="source \"$VENVS_HOME/venv/bin/activate\""

source "/home/zac/dotfiles/utils.d/source_rc_utils.sh" 1>/dev/null
source "/home/zac/dotfiles/utils.d/make_utilsd_symlinks.sh" 1>/dev/null

