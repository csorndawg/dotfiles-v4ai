[init]
	defaultBranch = main

[core]
	editor = vim
	#pager = bat

[branch]
    sort = -committerdate

[merge]
	ff = only
	conflictstyle = diff3

[diff]
	tool = vimdiff
	colorMoved = default

[credential]
	# cache expires after 10 hours
	helper = cache --timeout=36000

[push]
	autoSetupRemote = true

