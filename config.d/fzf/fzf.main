
# Sourcing file for FZF configuration files

# configure FZF shell integration for current shell 
if [ -n "$ZSH_VERSION" ]; then
    # Zsh-specific fzf initialization
    source <(fzf --zsh)
elif [ -n "$BASH_VERSION" ]; then
    # Bash-specific fzf initialization
    eval "$(fzf --bash)"
fi

FZF_CONFIGD_DIRPATH="$HOME/dotfiles/config.d/fzf"

# @NOTE: fzf.config MUST be sourced first  
FILES_TO_SOURCE=(fzf.config fzf_fuzzy_comp.bash fzf_utils.bash)
#FILES_TO_SOURCE=(fzf.config fzf_fuzzy_comp.bash)

echo -e "\nStarting sourcing for FZF files\n"
for file in ${FILES_TO_SOURCE[@]}; do 
  ABSPATH="$FZF_CONFIGD_DIRPATH/$file"
  echo -e "Sourcing FZF Config Module:\t \"$ABSPATH\""
  source $ABSPATH
done
echo -e "\nDone sourcing FZF files"
